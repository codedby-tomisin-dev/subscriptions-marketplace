rules_version = '2';

// Clients only ever read. Every write goes through a Cloud Function, which
// keeps Stripe and the denormalised summaries in step.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function ownsDoc() {
      return signedIn() && resource.data.customerId == request.auth.uid;
    }

    // The catalog is public: the storefront shows it to everyone.
    match /boxes/{boxId} {
      allow read: if true;
    }

    match /customers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /subscriptions/{id} {
      allow read: if isAdmin() || ownsDoc();
    }

    match /orders/{id} {
      allow read: if isAdmin() || ownsDoc();
    }

    match /events/{id} {
      allow read: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isAdmin();
    }

    match /inventory/{id} {
      allow read: if isAdmin();
    }

    match /reorders/{id} {
      allow read: if isAdmin();
    }

    match /metrics_snapshots/{id} {
      allow read: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin();
    }

    match /admin_invites/{email} {
      allow read: if isAdmin();
    }

    // counters and stripe_events are functions-only: no rule, so no client access.
    match /{document=**} {
      allow write: if false;
    }
  }
}
